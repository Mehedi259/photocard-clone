{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/login", "destination": "/account/index.html" },
    { "source": "/register", "destination": "/account/index.html" },
    { "source": "/forgot-password", "destination": "/account/index.html" },
    { "source": "/logout", "destination": "/" },
    { "source": "/account", "destination": "/account/index.html" },
    { "source": "/account/brand-info", "destination": "/account/brand-info.html" },
    { "source": "/account/template/photocard", "destination": "/account/template/photocard.html" },
    { "source": "/account/template/opinion", "destination": "/account/template/opinion.html" },
    { "source": "/account/template/thumbnail", "destination": "/account/template/thumbnail.html" },
    { "source": "/account/template/videoframe", "destination": "/account/template/videoframe.html" },
    { "source": "/account/packages", "destination": "/account/index.html" },
    { "source": "/account/info", "destination": "/account/info.html" },
    { "source": "/account/security", "destination": "/account/security.html" },
    { "source": "/account/news-rewrite", "destination": "/account/index.html" },
    { "source": "/account/video-editor", "destination": "/account/video-editor.html" },
    { "source": "/account/voice-over", "destination": "/account/voice-over.html" },
    { "source": "/create/photocard/:id", "destination": "/create/photocard?id=:id" },
    { "source": "/create/thumbnail/:id", "destination": "/create/photocard?type=thumbnail&id=:id" },
    { "source": "/create/opinion/:id", "destination": "/create/photocard?type=opinion&id=:id" }
  ]
}
